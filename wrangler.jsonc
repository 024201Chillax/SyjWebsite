{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "syjwebsite",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": ["/playground/maxxxine/motion-web.mp4"]
  },
  "services": [{"binding": "WORKER_SELF_REFERENCE", "service": "syjwebsite"}],
  "r2_buckets": [{"binding": "PORTFOLIO_MEDIA", "bucket_name": "syjwebsite-media"}],
  "images": {"binding": "IMAGES"}
}
